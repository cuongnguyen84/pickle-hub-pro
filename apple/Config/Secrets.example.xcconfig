// Copy this file to `Secrets.xcconfig` and fill in the values.
// `Secrets.xcconfig` is git-ignored.
//
// The anon (publishable) key is designed to ship inside clients — it is
// gated by Row Level Security on the server. It is NOT a service-role key.

SUPABASE_PROJECT_REF = your_project_ref
SUPABASE_ANON_KEY = your_anon_publishable_key

// Public Cloudflare Turnstile site key. Leave empty to keep the proven web
// registration fallback; native OTP is activated only when this is configured.
TURNSTILE_SITE_KEY =

// Public Firebase client identifiers for FCM push. These are configuration,
// not server credentials; never add FCM_SERVICE_ACCOUNT_JSON to the app.
FIREBASE_GOOGLE_APP_ID =
FIREBASE_GCM_SENDER_ID =
FIREBASE_API_KEY =
FIREBASE_PROJECT_ID =
