// Copy this file to `Secrets.xcconfig` and fill in the values.
// `Secrets.xcconfig` is git-ignored.
//
// The anon (publishable) key is designed to ship inside clients — it is
// gated by Row Level Security on the server. It is NOT a service-role key.

SUPABASE_PROJECT_REF = ci-placeholder
SUPABASE_ANON_KEY = ci_anon_publishable_key

// Public, non-secret placeholders keep CI build/preflight validation deterministic.
// Replace them in the ignored Secrets.xcconfig for device and shipping builds.
TURNSTILE_SITE_KEY = 1x00000000000000000000AA

// Public Firebase client identifiers for FCM push. These are configuration,
// not server credentials; never add FCM_SERVICE_ACCOUNT_JSON to the app.
FIREBASE_GOOGLE_APP_ID = 1:123456789012:ios:abcdef1234567890
FIREBASE_GCM_SENDER_ID = 123456789012
FIREBASE_API_KEY = AIza00000000000000000000000000000000000
FIREBASE_PROJECT_ID = ci-placeholder
