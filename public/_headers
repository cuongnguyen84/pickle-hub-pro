# Content-hashed static assets — immutable cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# KHÔNG dùng rule /*.js immutable! Nó từng nuốt cả /sw.js → CDN Cloudflare
# giữ service worker cũ 29 ngày → mọi client cài lại SW cũ với precache chunk
# đã 404 → kẹt vòng lặp "Đang tải lại..." bất kể deploy gì (2026-07-08).
# Cloudflare Pages _headers KHÔNG override theo rule cụ thể hơn — mọi rule
# khớp đều áp, nên phải BỎ rule rộng thay vì thêm rule đè (bài học sw-v2:
# rule no-cache đặt sau vẫn thua, CDN cache luôn sw-v2.js immutable).
# JS hash của Vite đã nằm trọn trong /assets/* ở trên; JS ở root chỉ còn
# sw-v3.js (no-cache dưới đây) và workbox-<hash>.js (etag revalidate là đủ).

# Service worker — TUYỆT ĐỐI không cache, mọi thế hệ tên file.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/sw-v2.js
  Cache-Control: no-cache, no-store, must-revalidate

/sw-v3.js
  Cache-Control: no-cache, no-store, must-revalidate

# Freshness beacon cho staleShell.ts — phải luôn là bản mới nhất.
/build-id.txt
  Cache-Control: no-cache, no-store, must-revalidate

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon
/favicon.ico
  Cache-Control: public, max-age=86400

# Sitemap and robots (served by Pages Functions, but headers apply if cached)
/sitemap.xml
  Cache-Control: public, max-age=300

/robots.txt
  Cache-Control: public, max-age=3600

# Homepage — short cache only. Security headers come from /* below.
#
# 2026-08-19 — this block used to repeat X-Content-Type-Options,
# X-Frame-Options and Referrer-Policy, which /* already sets. Pages applies
# EVERY matching rule rather than the most specific one (see the sw.js note
# at the top of this file), so the homepage shipped each of those three
# twice. Permissions-Policy was declared ONLY here, so every page except /
# shipped without it — it now lives in /* and covers the whole site.
/
  Cache-Control: public, max-age=300, s-maxage=3600

# All other pages inherit security headers + CSP including DUPR SSO iframe
# allowance. DUPR SSO embeds dashboard.dupr.com (prod) or uat.dupr.gg
# (UAT) — without these in frame-src, Chrome blocks the connect modal
# with "This content is blocked. Contact the site owner to fix the issue."
#
# Report-Only mirror: today it is byte-identical to the enforced policy
# except for report-uri, which the enforced header does not carry. It was
# once described as "enforce MINUS the DUPR allowances", but it is not and
# has not been — the DUPR domains are in both. So it is NOT a canary: every
# report it produces is a violation the enforced policy ALREADY blocked.
# Treat client_errors csp_violation rows as "this is broken in production
# right now", not "this would break if we tightened". Before using it as a
# real pre-flight, make it genuinely tighter than the line above it.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
