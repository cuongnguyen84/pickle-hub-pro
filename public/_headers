# Content-hashed static assets — immutable cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# KHÔNG dùng rule /*.js immutable! Nó từng nuốt cả /sw.js → CDN Cloudflare
# giữ service worker cũ 29 ngày → mọi client cài lại SW cũ với precache chunk
# đã 404 → kẹt vòng lặp "Đang tải lại..." bất kể deploy gì (2026-07-08).
# Cloudflare Pages _headers KHÔNG override theo rule cụ thể hơn — mọi rule
# khớp đều áp, nên phải BỎ rule rộng thay vì thêm rule đè (bài học sw-v2:
# rule no-cache đặt sau vẫn thua, CDN cache luôn sw-v2.js immutable).
# JS hash của Vite đã nằm trọn trong /assets/* ở trên; JS ở root chỉ còn
# sw-v3.js (no-cache dưới đây) và workbox-<hash>.js (etag revalidate là đủ).

# Service worker — TUYỆT ĐỐI không cache, mọi thế hệ tên file.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/sw-v2.js
  Cache-Control: no-cache, no-store, must-revalidate

/sw-v3.js
  Cache-Control: no-cache, no-store, must-revalidate

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Favicon
/favicon.ico
  Cache-Control: public, max-age=86400

# Sitemap and robots (served by Pages Functions, but headers apply if cached)
/sitemap.xml
  Cache-Control: public, max-age=300

/robots.txt
  Cache-Control: public, max-age=3600

# HTML pages — short cache, security headers
/
  Cache-Control: public, max-age=300, s-maxage=3600
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# All other pages inherit security headers + CSP including DUPR SSO iframe
# allowance. DUPR SSO embeds dashboard.dupr.com (prod) or uat.dupr.gg
# (UAT) — without these in frame-src, Chrome blocks the connect modal
# with "This content is blocked. Contact the site owner to fix the issue."
#
