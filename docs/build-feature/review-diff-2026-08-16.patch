+    expect(screen.queryByText(/giai đoạn tiếp theo/i)).toBeNull();
+  });
+
+  it("renders the shared Vietnamese state label", () => {
+    mount("pending_activation");
+    expect(screen.getByText("Chờ kích hoạt")).toBeTruthy();
+  });
+});
