<!--
  iOS Info.plist Additions for ThePickleHub
  
  After running `npx cap add ios`, add these keys to ios/App/App/Info.plist:
-->

<!-- ATS: only relax for MEDIA (Mux HLS may serve some cleartext segments).
     Do NOT enable the blanket NSAllowsArbitraryLoads / ...InWebContent — all
     app + API traffic is HTTPS, so a blanket exception needlessly weakens ATS
     (M8). Mirrors the scoped config already in apple/.../Info.plist. -->
<key>NSAppTransportSecurity</key>
<dict>
    <key>NSAllowsArbitraryLoadsForMedia</key>
    <true/>
</dict>

<!-- Allow inline video playback (critical for livestreams) -->
<key>UIWebViewAllowsInlineMediaPlayback</key>
<true/>

<!-- Allow autoplay without user gesture -->
<key>MediaTypesRequiringUserActionForPlayback</key>
<array/>

<!-- Background audio for livestreams -->
<key>UIBackgroundModes</key>
<array>
    <string>audio</string>
</array>

<!-- Status bar style -->
<key>UIStatusBarStyle</key>
<string>UIStatusBarStyleLightContent</string>
<key>UIViewControllerBasedStatusBarAppearance</key>
<true/>

<!-- Orientation support -->
<key>UISupportedInterfaceOrientations</key>
<array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
</array>
<key>UISupportedInterfaceOrientations~ipad</key>
<array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
</array>
